---
import { 
  Download, 
  ChevronRight, 
  Zap, 
  Smartphone, 
  Wallet, 
  ReceiptText, 
  Droplets, 
  Gamepad2, 
  CheckCircle2, 
  ShieldCheck 
} from 'lucide-astro';
import { getAppStatus } from '../lib/api';

const appStatus = await getAppStatus();
const downloadUrl = '/download';
const whatsappUrl = appStatus?.contact_whatsapp || '#';
const version = appStatus?.latest_version || '';
const fileSize = appStatus?.file_size || '';
---

<section id="beranda" class="relative overflow-hidden min-h-[90svh] lg:min-h-[92vh] flex items-center justify-center pt-24 pb-16 sm:pt-28 sm:pb-20 lg:pt-36 lg:pb-28 bg-gradient-to-b from-slate-50 via-white to-slate-50">
  <!-- Glowing Background Orbs & Full-width Ambient Layer -->
  <div class="absolute inset-0 w-full h-full pointer-events-none overflow-hidden">
    <div class="absolute top-[-10%] right-[-5%] w-[350px] sm:w-[500px] lg:w-[700px] h-[350px] sm:h-[500px] lg:h-[700px] bg-primary/10 rounded-full blur-3xl animate-pulse-slow"></div>
    <div class="absolute bottom-[-10%] left-[-5%] w-[320px] sm:w-[450px] lg:w-[650px] h-[320px] sm:h-[450px] lg:h-[650px] bg-secondary/10 rounded-full blur-3xl animate-pulse-slow" style="animation-delay: 2.5s;"></div>
    
    <!-- Background Floating Subtle Watermark Icons (Visible on Mobile & Desktop) -->
    <div class="absolute top-16 left-[5%] text-primary/10 animate-float-slow">
      <Zap class="w-10 h-10 sm:w-16 sm:h-16 lg:w-20 lg:h-20" />
    </div>
    <div class="absolute top-24 right-[6%] text-secondary/10 animate-float-reverse">
      <Smartphone class="w-12 h-12 sm:w-20 sm:h-20 lg:w-24 lg:h-24" />
    </div>
    <div class="absolute bottom-28 left-[6%] text-emerald-500/10 animate-float-alt">
      <Wallet class="w-10 h-10 sm:w-16 sm:h-16 lg:w-20 lg:h-20" />
    </div>
    <div class="absolute bottom-20 right-[8%] text-purple-500/10 animate-float-slow">
      <Gamepad2 class="w-10 h-10 sm:w-16 sm:h-16 lg:w-20 lg:h-20" />
    </div>
  </div>

  <div class="relative w-full max-w-7xl 2xl:max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Floating Product & Transaction Badges (Desktop & Laptop View) -->
    <!-- Card 1: Token PLN (Top Left) -->
    <div class="hidden lg:flex items-center gap-3 absolute top-6 -left-4 xl:left-2 2xl:left-6 bg-white/95 backdrop-blur-md px-4 py-2.5 rounded-2xl shadow-xl shadow-slate-200/60 border border-slate-100 animate-float pointer-events-none select-none z-10">
      <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center">
        <Zap class="w-5 h-5 fill-amber-500" />
      </div>
      <div class="text-left">
        <div class="flex items-center gap-1">
          <span class="text-xs font-bold text-slate-800">Token PLN 50.000</span>
          <CheckCircle2 class="w-3.5 h-3.5 text-emerald-500" />
        </div>
        <span class="text-[11px] font-medium text-slate-400">Detik ini • Sukses</span>
      </div>
    </div>

    <!-- Card 2: Pulsa & Kuota (Top Right) -->
    <div class="hidden lg:flex items-center gap-3 absolute top-10 -right-4 xl:right-2 2xl:right-6 bg-white/95 backdrop-blur-md px-4 py-2.5 rounded-2xl shadow-xl shadow-slate-200/60 border border-slate-100 animate-float-reverse pointer-events-none select-none z-10">
      <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-500 flex items-center justify-center">
        <Smartphone class="w-5 h-5" />
      </div>
      <div class="text-left">
        <div class="flex items-center gap-1">
          <span class="text-xs font-bold text-slate-800">Paket Data 25 GB</span>
          <span class="text-[10px] bg-emerald-50 text-emerald-600 font-bold px-1.5 py-0.5 rounded">Termurah</span>
        </div>
        <span class="text-[11px] font-medium text-slate-400">Harga Grosir Reseller</span>
      </div>
    </div>

    <!-- Card 3: Top Up E-Wallet & QRIS (Bottom Left) -->
    <div class="hidden lg:flex items-center gap-3 absolute bottom-4 -left-2 xl:left-4 2xl:left-8 bg-white/95 backdrop-blur-md px-4 py-2.5 rounded-2xl shadow-xl shadow-slate-200/60 border border-slate-100 animate-float-alt pointer-events-none select-none z-10">
      <div class="w-10 h-10 rounded-xl bg-teal-500/10 text-teal-600 flex items-center justify-center">
        <Wallet class="w-5 h-5" />
      </div>
      <div class="text-left">
        <div class="flex items-center gap-1">
          <span class="text-xs font-bold text-slate-800">DANA / OVO / GoPay</span>
          <CheckCircle2 class="w-3.5 h-3.5 text-teal-500" />
        </div>
        <span class="text-[11px] font-medium text-slate-400">QRIS Instan 24 Jam</span>
      </div>
    </div>

    <!-- Card 4: Tagihan Pascabayar / PDAM (Bottom Right) -->
    <div class="hidden lg:flex items-center gap-3 absolute bottom-2 -right-2 xl:right-4 2xl:right-8 bg-white/95 backdrop-blur-md px-4 py-2.5 rounded-2xl shadow-xl shadow-slate-200/60 border border-slate-100 animate-float pointer-events-none select-none z-10" style="animation-delay: 1.5s;">
      <div class="w-10 h-10 rounded-xl bg-rose-500/10 text-rose-500 flex items-center justify-center">
        <ReceiptText class="w-5 h-5" />
      </div>
      <div class="text-left">
        <div class="flex items-center gap-1">
          <span class="text-xs font-bold text-slate-800">PDAM & BPJS Lunas</span>
          <ShieldCheck class="w-3.5 h-3.5 text-rose-500" />
        </div>
        <span class="text-[11px] font-medium text-slate-400">Struk Resmi Siap Cetak</span>
      </div>
    </div>

    <!-- Center Content -->
    <div class="text-center max-w-4xl mx-auto relative z-20 py-2 sm:py-4">
      <div id="hero-version-badge" class={`inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-blue-100 text-primary-dark text-sm font-bold mb-4 sm:mb-6 animate-fade-in ${!version && 'hidden'}`}>
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-dark opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-primary-dark"></span>
        </span>
        <span id="hero-version-text">Versi {version}</span>
      </div>
      
      <h1 class="text-3xl sm:text-5xl lg:text-7xl font-extrabold text-slate-900 leading-tight mb-4 sm:mb-8 tracking-tight">
        Semua Tagihan & Isi Ulang, <span class="text-primary">Gampang</span><span class="text-secondary">Beres</span> dalam Satu Aplikasi!
      </h1>
      
      <p class="text-base sm:text-xl text-slate-600 mb-6 sm:mb-10 leading-relaxed max-w-3xl mx-auto font-normal">
        Aplikasi andalan untuk kebutuhan digital harianmu. Harga dasar super murah, cocok untuk dipakai sendiri biar hemat atau dijual lagi di warung/konter biar untung maksimal.
      </p>

      <!-- Mobile Floating Dynamic Pills (Special for Smartphone Screens) -->
      <div class="lg:hidden flex items-center justify-center gap-2 mb-6 pointer-events-none select-none">
        <div class="flex items-center gap-1.5 bg-white/90 backdrop-blur-md px-3 py-1.5 rounded-full shadow-md shadow-slate-200/50 border border-slate-100 animate-float text-left">
          <div class="w-6 h-6 rounded-full bg-amber-500/10 text-amber-500 flex items-center justify-center">
            <Zap class="w-3.5 h-3.5 fill-amber-500" />
          </div>
          <span class="text-[11px] font-bold text-slate-700">Token PLN 50k</span>
          <CheckCircle2 class="w-3 h-3 text-emerald-500" />
        </div>

        <div class="flex items-center gap-1.5 bg-white/90 backdrop-blur-md px-3 py-1.5 rounded-full shadow-md shadow-slate-200/50 border border-slate-100 animate-float-reverse text-left">
          <div class="w-6 h-6 rounded-full bg-blue-500/10 text-blue-500 flex items-center justify-center">
            <Smartphone class="w-3.5 h-3.5 text-blue-500" />
          </div>
          <span class="text-[11px] font-bold text-slate-700">Paket Data 25 GB</span>
          <span class="text-[9px] bg-emerald-50 text-emerald-600 font-bold px-1 rounded">Murah</span>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 max-w-md sm:max-w-none mx-auto w-full">
        <div class="group relative w-full sm:w-auto">
          <a 
            id="hero-download-link"
            href={downloadUrl} 
            class="flex items-center justify-center space-x-3 w-full sm:w-auto bg-primary hover:bg-primary-dark text-white px-6 sm:px-8 py-3.5 sm:py-4 rounded-2xl text-base sm:text-lg font-bold transition-all transform hover:-translate-y-1 hover:shadow-2xl hover:shadow-primary/40 active:translate-y-0 active:scale-95 shadow-xl shadow-primary/30 min-h-[48px]"
          >
            <Download class="w-5 h-5 sm:w-6 sm:h-6 animate-bounce flex-shrink-0" />
            <span>Download Aplikasi (APK)</span>
          </a>
          <!-- Tooltip -->
          <div id="hero-filesize-tooltip" class={`hidden md:block absolute -bottom-12 left-1/2 -translate-x-1/2 w-max opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none ${!fileSize ? '!hidden' : ''}`}>
            <div class="bg-slate-900 text-white text-xs py-1 px-3 rounded-md shadow-lg">
              Ukuran <span id="hero-filesize-text">{fileSize}</span>, langsung install.
            </div>
          </div>
          <!-- Mobile Explicit Subtext Note -->
          <p class="md:hidden text-xs text-slate-500 mt-2 text-center">Ukuran file <span id="hero-filesize-mobile-text">{fileSize}</span> • Langsung install</p>
        </div>
        
        <a 
          id="hero-whatsapp-link"
          href={whatsappUrl} 
          class="flex items-center justify-center space-x-2 w-full sm:w-auto text-slate-700 hover:text-primary bg-white hover:bg-slate-50 border border-slate-200 px-6 sm:px-8 py-3.5 sm:py-4 rounded-2xl text-base sm:text-lg font-semibold transition-all shadow-sm hover:shadow min-h-[48px]"
        >
          <span>Tanya CS</span>
          <ChevronRight class="w-5 h-5 flex-shrink-0" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-10px) rotate(0.5deg); }
  }
  @keyframes float-reverse {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(10px) rotate(-0.5deg); }
  }
  @keyframes float-alt {
    0%, 100% { transform: translateY(0px) translateX(0px); }
    50% { transform: translateY(-8px) translateX(4px); }
  }
  @keyframes float-slow {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-18px); }
  }

  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
    will-change: transform, opacity;
  }
  .animate-float {
    animation: float 5s ease-in-out infinite;
    will-change: transform;
  }
  .animate-float-reverse {
    animation: float-reverse 6s ease-in-out infinite;
    will-change: transform;
  }
  .animate-float-alt {
    animation: float-alt 5.5s ease-in-out infinite;
    will-change: transform;
  }
  .animate-float-slow {
    animation: float-slow 7s ease-in-out infinite;
    will-change: transform;
  }
  .animate-pulse-slow {
    animation: pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    will-change: opacity;
  }
</style>
