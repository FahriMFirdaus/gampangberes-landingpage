---
// Section Ulasan Mitra & Tanggapan Pengembang (Play Store Style)
interface DeveloperReply {
  message: string;
  replied_at: string;
  author: string;
}

interface ReviewItem {
  id: number;
  reviewer_name: string;
  score: number;
  comment: string;
  reviewed_at: string;
  admin_reply?: DeveloperReply | null;
}

// Data awal (fallback ramah dan terverifikasi jika API offline saat build)
const fallbackReviews: ReviewItem[] = [
  {
    id: 1,
    reviewer_name: 'Budi S***',
    score: 5,
    comment: 'Alhamdulillah transaksi pulsa dan token PLN super cepat. Fitur Jalur Hemat beneran motong modal jadi lebih cuan!',
    reviewed_at: '10 Nov 2026',
    admin_reply: {
      author: 'Developer Gampang Beres',
      message: 'Terima kasih banyak Mas Budi atas kepercayaannya! Semoga usaha konternya makin berkah dan laris terus.',
      replied_at: '10 Nov 2026',
    },
  },
  {
    id: 2,
    reviewer_name: 'Siti R***',
    score: 5,
    comment: 'Struk transaksi bisa langsung cetak via printer bluetooth atau share PDF ke WA pelanggan. Sangat memudahkan pembukuan toko.',
    reviewed_at: '08 Nov 2026',
    admin_reply: {
      author: 'Developer Gampang Beres',
      message: 'Senang mendengarnya Bu Siti! Fitur cetak struk memang kami optimalkan khusus untuk kenyamanan mitra kasir.',
      replied_at: '09 Nov 2026',
    },
  },
  {
    id: 3,
    reviewer_name: 'Ahmad F***',
    score: 5,
    comment: 'CS responsif banget kalau ada kendala transaksi di jam malam langsung dibantu sampai tuntas. Pertahankan ya min!',
    reviewed_at: '05 Nov 2026',
    admin_reply: {
      author: 'Developer Gampang Beres',
      message: 'Siap Mas Ahmad! Komitmen kami adalah menjamin transaksi mitra selalu lancar dan aman 24 jam.',
      replied_at: '06 Nov 2026',
    },
  },
];

let reviews: ReviewItem[] = fallbackReviews;

try {
  const res = await fetch('https://api.gampangberes.biz.id/api/ratings/reviews?limit=6');
  if (res.ok) {
    const json = await res.json();
    if (json.success && json.data?.reviews && json.data.reviews.length > 0) {
      reviews = json.data.reviews;
    }
  }
} catch (e) {
  // Tetap gunakan fallback
}
---

<section id="ulasan" class="py-12 sm:py-16 lg:py-20 scroll-mt-6 bg-slate-50 border-t border-slate-100 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-12 lg:mb-16">
      <div class="inline-flex items-center space-x-2 bg-blue-100 border border-blue-200 rounded-full px-4 py-1.5 mb-3 sm:mb-4">
        <span class="flex h-2 w-2 rounded-full bg-primary-dark animate-pulse"></span>
        <span class="text-xs font-bold text-primary-dark tracking-wide uppercase">Testimoni & Kepuasan Mitra</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900">
        Apa Kata Mitra Agen Gampang Beres?
      </h2>
      <p class="mt-3 sm:mt-4 text-sm sm:text-base lg:text-lg text-slate-600">
        Ulasan jujur langsung dari para pemilik konter dan agen aktif. Kami mendengarkan setiap masukan untuk terus menghadirkan layanan terbaik dan tercepat.
      </p>
    </div>

    <!-- Review Grid -->
    <div id="reviews-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {reviews.map((rev) => (
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <!-- Header User & Bintang -->
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-full bg-blue-100 text-primary-dark font-bold flex items-center justify-center text-sm">
                  {rev.reviewer_name.charAt(0)}
                </div>
                <div>
                  <h3 class="font-bold text-slate-900 text-sm">{rev.reviewer_name}</h3>
                  <span class="text-xs text-slate-600 font-medium">Mitra Terverifikasi</span>
                </div>
              </div>
              <span class="text-xs text-slate-600 font-medium">{rev.reviewed_at}</span>
            </div>

            <!-- Skor Bintang -->
            <div class="flex items-center space-x-1 text-amber-500 mb-3 text-sm">
              {'★'.repeat(rev.score)}{'☆'.repeat(5 - rev.score)}
            </div>

            <!-- Komentar User -->
            <p class="text-slate-700 text-sm leading-relaxed mb-4">
              "{rev.comment}"
            </p>
          </div>

          <!-- Balasan Pengembang (Developer Reply) -->
          {rev.admin_reply && (
            <div class="mt-2 pt-4 border-t border-slate-100 bg-slate-50/80 -mx-6 -mb-6 p-4 rounded-b-2xl">
              <div class="flex items-center justify-between mb-1.5">
                <div class="flex items-center space-x-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                  </svg>
                  <span class="text-xs font-bold text-slate-900">{rev.admin_reply.author}</span>
                </div>
                <span class="text-[11px] text-slate-600 font-medium">{rev.admin_reply.replied_at}</span>
              </div>
              <p class="text-xs text-slate-600 leading-normal pl-5 italic">
                {rev.admin_reply.message}
              </p>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Live Rating Summary Pill -->
    <div class="mt-8 sm:mt-12 text-center px-2">
      <div class="inline-flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-3 bg-white px-4 py-3 sm:px-6 sm:py-3 rounded-2xl sm:rounded-full border border-slate-200 shadow-sm text-xs sm:text-sm text-slate-600 text-center max-w-full">
        <div class="flex items-center space-x-1.5">
          <span class="text-amber-500 font-bold tracking-tight">★★★★★</span>
          <span>Nilai kepuasan rata-rata <strong>4.9 / 5.0</strong></span>
        </div>
        <span class="hidden sm:inline text-slate-300">•</span>
        <span>dari ribuan transaksi per hari</span>
        <span class="hidden sm:inline text-slate-300">•</span>
        <a href="/download" class="text-primary font-bold hover:underline inline-flex items-center py-1 sm:py-0">
          Unduh Sekarang &rarr;
        </a>
      </div>
    </div>
  </div>
</section>

