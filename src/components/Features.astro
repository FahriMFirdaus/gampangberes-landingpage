---
import { 
  Zap, 
  ShieldCheck, 
  Printer, 
  QrCode, 
  Sparkles, 
  TrendingUp,
  WalletCards,
  MessageSquareWarning
} from 'lucide-astro';
import { getAppStatus, formatCurrency } from '../lib/api';

const appStatus = await getAppStatus();
const minDepositReseller = formatCurrency(appStatus?.min_deposit_reseller) || 'Rp 10.000';

const features = [
  {
    icon: Zap,
    title: 'Transaksi Secepat Kilat',
    description: 'Terhubung langsung dengan multi-biller server pusat untuk memastikan setiap transaksi pulsa, paket data, dan tagihan sukses dalam hitungan detik.',
    color: 'bg-primary',
  },
  {
    icon: Sparkles,
    title: 'Jalur Hemat Otomatis',
    description: 'Sistem cerdas kami otomatis mencarikan supplier termurah dan mengembalikan selisih harga (auto-refund) jika ada opsi yang lebih hemat.',
    color: 'bg-secondary',
  },
  {
    icon: Printer,
    title: 'Cetak Struk Bluetooth & Toko',
    description: 'Cetak struk fisik via printer thermal Bluetooth atau bagikan struk digital via WhatsApp dengan nama toko, logo, dan harga jual yang bisa Anda atur sendiri.',
    color: 'bg-emerald-600',
  },
  {
    icon: QrCode,
    title: 'Verifikasi Struk Digital Online',
    description: 'Setiap struk digital dilengkapi QR Code verifikasi keaslian (cek.gampangberes.biz.id) sehingga pelanggan merasa aman dan percaya.',
    color: 'bg-indigo-600',
  },
  {
    icon: WalletCards,
    title: 'Smart Deposit 24/7 Bebas MDR',
    description: 'Isi saldo fleksibel kapan saja: QRIS Otomatis instan 24 jam atau Transfer GoPay Manual bebas potongan biaya admin untuk nominal besar.',
    color: 'bg-cyan-600',
  },
  {
    icon: TrendingUp,
    title: 'Harga Reseller & Bangun Tim',
    description: `Mulai deposit ringan dari <span id="dynamic-feature-min-deposit-reseller">${minDepositReseller}</span>. Dapatkan komisi referal pasif setiap kali jaringan downline Anda bertransaksi.`,
    color: 'bg-amber-600',
  },
  {
    icon: MessageSquareWarning,
    title: 'Bantuan Komplain 1-Klik',
    description: 'Jika transaksi tertunda atau nomor salah, ajukan komplain langsung dari struk. Customer Support kami sigap membantu hingga tuntas.',
    color: 'bg-rose-600',
  },
  {
    icon: ShieldCheck,
    title: 'Aman & Transparan Berlapis',
    description: 'Perlindungan PIN 6-digit untuk setiap transaksi & penarikan, mutasi saldo realtime, serta enkripsi data standar industri.',
    color: 'bg-primary-dark',
  },
];
---

<section id="fitur" class="py-20 scroll-mt-6 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold mb-4">
        <span>Solusi Usaha Modern</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-4">Fitur Lengkap untuk Sukses Usaha Konter & Pribadi</h2>
      <p class="text-base sm:text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Bukan sekadar aplikasi pulsa biasa. Kami rancang platform profesional yang memprioritaskan kecepatan transaksi, efisiensi modal, dan kemudahan operasional konter harian Anda.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((feature) => (
        <div class="relative group p-6 sm:p-7 rounded-3xl border border-slate-100 bg-slate-50/50 hover:bg-white hover:border-slate-200 transition-all duration-300 hover:shadow-xl hover:shadow-slate-100 flex flex-col justify-between">
          <div>
            <div class="mb-5 w-12 h-12 rounded-2xl flex items-center justify-center text-white transition-transform group-hover:scale-110 shadow-lg shadow-slate-200 flex-shrink-0" class:list={[feature.color]}>
              <feature.icon class="w-6 h-6" />
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2.5 leading-snug">{feature.title}</h3>
            <p class="text-slate-600 leading-relaxed text-xs sm:text-sm" set:html={feature.description}>
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
