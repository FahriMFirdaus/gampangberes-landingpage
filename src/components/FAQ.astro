---
import { ChevronDown, HelpCircle } from 'lucide-astro';
import { getAppStatus, formatCurrency } from '../lib/api';

const appStatus = await getAppStatus();
const minDepositReseller = formatCurrency(appStatus?.min_deposit_reseller) || 'Rp 10.000';
const minDepositAgen = formatCurrency(appStatus?.min_deposit_agen) || 'Rp 100.000';
const minWithdrawal = formatCurrency(appStatus?.min_withdrawal) || 'Rp 20.000';

const faqs = [
  {
    question: 'Apakah aplikasi Gampang Beres aman digunakan?',
    answer: 'Sangat aman. Kami menggunakan enkripsi standar industri HTTPS/TLS, autentikasi sesi aman, dan perlindungan PIN 6-digit untuk setiap eksekusi transaksi atau penarikan. Saldo tersimpan aman di sistem terproteksi dan setiap mutasi tercatat transparan detik per detik.',
  },
  {
    question: 'Bagaimana jika transaksi gagal atau nomor tujuan salah?',
    answer: 'Jika transaksi berstatus gagal dari provider atau nomor tidak valid, <strong>saldo Anda akan otomatis dikembalikan 100% secara instan (Auto-Refund)</strong> ke akun tanpa potongan apa pun. Anda juga bisa menekan tombol Bantuan Komplain langsung dari struk transaksi untuk chat dengan Customer Service kami.',
  },
  {
    question: 'Apa itu fitur Jalur Hemat dan bagaimana cara kerjanya?',
    answer: 'Jalur Hemat adalah sistem cerdas Gampang Beres yang otomatis memilih jalur supplier termurah dari multi-biller. Jika sistem menemukan harga modal yang lebih murah dari estimasi awal, <strong>selisih uangnya akan langsung dikembalikan otomatis ke saldo Anda</strong>. Makin sering transaksi, makin banyak hematnya!',
  },
  {
    question: 'Bagaimana cara mendaftar dan apa bedanya Reseller vs Agen?',
    answer: `Semua pengguna baru otomatis terdaftar gratis sebagai Reseller dengan minimal deposit mulai dari <span id="dynamic-faq-min-deposit-reseller">${minDepositReseller}</span>. Saat Anda rutin bertransaksi atau memiliki saldo <span id="dynamic-faq-min-deposit-agen">${minDepositAgen}</span>, Anda bisa langsung mengajukan upgrade ke status <strong>Mitra Agen</strong> dari menu Bisnis aplikasi untuk menikmati harga wholesale termurah dan fitur transfer saldo.`,
  },
  {
    question: 'Apakah bisa mendapatkan komisi dari Kode Referal / Downline?',
    answer: 'Bisa banget! Setiap pengguna memiliki Kode Referal unik di aplikasi. Bagikan kode tersebut ke rekan, tetangga, atau jaringan konter Anda. Setiap kali downline bertransaksi, <strong>komisi pasif otomatis masuk ke saldo Anda</strong> dan bisa digunakan transaksi kembali atau dicairkan ke rekening.',
  },
  {
    question: 'Metode deposit apa saja yang didukung?',
    answer: 'Kami menyediakan fitur Smart Deposit: (1) <strong>QRIS Otomatis 24 Jam</strong> yang bisa dibayar dari semua e-wallet (GoPay, OVO, Dana, ShopeePay) serta m-Banking dengan saldo masuk dalam hitungan detik. (2) <strong>Transfer GoPay Manual</strong> tanpa biaya potongan MDR yang sangat menguntungkan untuk nominal besar.',
  },
  {
    question: 'Apakah bisa cetak struk untuk pelanggan konter/warung?',
    answer: 'Bisa banget! Gampang Beres mendukung cetak struk fisik ke printer thermal Bluetooth (ukuran kertas 58mm/80mm) dan berbagi struk digital lewat WhatsApp/PDF. Anda bebas mengedit nama toko, alamat, catatan kaki, hingga menaikkan harga jual sesuai keuntungan yang Anda inginkan. Struk digital juga memiliki link verifikasi QR Code resmi (cek.gampangberes.biz.id).',
  },
  {
    question: 'Berapa minimal penarikan saldo (withdrawal)?',
    answer: `Anda dapat menarik kembali saldo Anda ke rekening bank atau e-wallet terdaftar dengan batas minimal <span id="dynamic-min-withdrawal">${minWithdrawal}</span>. Penarikan diproses cepat dan aman ke rekening atas nama Anda sendiri.`,
  },
  {
    question: 'Bagaimana cara menginstall APK secara manual?',
    answer: 'Setelah klik tombol Download APK, buka file APK yang telah terunduh di HP Anda. Jika muncul peringatan keamanan "Install dari sumber tidak dikenal" (Unknown Sources), cukup centang izinkan untuk browser Anda. File APK kami resmi dan bebas dari virus/malware.',
  },
];
---

<section id="faq" class="py-24 bg-slate-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold mb-4">
        <HelpCircle class="w-4 h-4" />
        <span>Pusat Bantuan & FAQ</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-4">Pertanyaan yang Sering Diajukan</h2>
      <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto">
        Semua informasi penting seputar keamanan, fitur unggulan, dan cara kerja aplikasi Gampang Beres.
      </p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <div class="group bg-white rounded-2xl border border-slate-100 overflow-hidden transition-all duration-300 hover:shadow-md">
          <button 
            class="faq-button flex items-center justify-between w-full p-6 text-left"
            data-index={index}
          >
            <span class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-primary transition-colors">{faq.question}</span>
            <ChevronDown class="w-5 h-5 text-slate-400 group-hover:text-primary transition-transform duration-300 faq-icon flex-shrink-0 ml-4" />
          </button>
          <div class="faq-answer max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
            <div class="p-6 pt-0 text-slate-600 leading-relaxed border-t border-slate-50 text-sm sm:text-base" set:html={faq.answer}>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const faqButtons = document.querySelectorAll('.faq-button');
  
  faqButtons.forEach(button => {
    button.addEventListener('click', () => {
      const container = button.closest('.group');
      const answer = container?.querySelector('.faq-answer');
      const icon = button.querySelector('.faq-icon');
      
      // Close other open FAQs
      document.querySelectorAll('.faq-answer').forEach(el => {
        if (el !== answer) {
          (el as HTMLElement).style.maxHeight = '0';
        }
      });
      document.querySelectorAll('.faq-icon').forEach(el => {
        if (el !== icon) {
          el.classList.remove('rotate-180');
        }
      });

      // Toggle current FAQ
      if (answer) {
        const isClosed = (answer as HTMLElement).style.maxHeight === '0px' || !(answer as HTMLElement).style.maxHeight;
        if (isClosed) {
          (answer as HTMLElement).style.maxHeight = `${answer.scrollHeight}px`;
          icon?.classList.add('rotate-180');
        } else {
          (answer as HTMLElement).style.maxHeight = '0';
          icon?.classList.remove('rotate-180');
        }
      }
    });
  });
</script>
