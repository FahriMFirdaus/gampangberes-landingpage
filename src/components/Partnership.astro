---
import { CheckCircle2, Users2, Store, Sparkles, ArrowRight } from 'lucide-astro';
import { getAppStatus, formatCurrency } from '../lib/api';

const appStatus = await getAppStatus();
const minDepositReseller = formatCurrency(appStatus?.min_deposit_reseller) || 'Rp 10.000';
const minDepositAgen = formatCurrency(appStatus?.min_deposit_agen) || 'Rp 100.000';

const tiers = [
  {
    name: 'Reseller (Level Awal)',
    icon: Store,
    badge: 'Langsung Aktif',
    description: 'Cocok untuk penggunaan pribadi, warung makan, atau pemula yang baru merintis jualan pulsa & PPOB.',
    features: [
      'Pendaftaran 100% Gratis & Otomatis',
      'Harga Dasar Reseller Murah',
      `Minimal Deposit Mulai <span id="dynamic-min-deposit-reseller">${minDepositReseller}</span>`,
      'Bisa Bangun Downline & Komisi Referal',
      'Cetak Struk Bluetooth & Struk Digital',
    ],
    cta: 'Daftar Gratis Sekarang',
    link: '/download',
    highlight: false,
    footnote: 'Setiap akun baru otomatis aktif sebagai Reseller.',
  },
  {
    name: 'Mitra Agen',
    icon: Users2,
    badge: 'Level Bisnis',
    description: 'Untuk konter pulsa, toko kelontong aktif, & agen profesional yang membutuhkan harga wholesale termurah.',
    features: [
      'Harga Wholesale Paling Murah (Margin Tertinggi)',
      'Fitur Transfer Saldo Antar Pengguna',
      `Syarat Transaksi Aktif & Saldo <span id="dynamic-min-deposit-agen">${minDepositAgen}</span>`,
      'Bisa Bangun Jaringan Referal Lebih Luas',
      'Jalur Prioritas Customer Support',
    ],
    cta: 'Upgrade Lewat Aplikasi',
    link: '/download',
    highlight: true,
    footnote: 'Pengajuan upgrade langsung mandiri lewat menu Bisnis di aplikasi.',
  },
];
---

<section id="kemitraan" class="py-24 scroll-mt-24 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-bold mb-4">
        <Sparkles class="w-4 h-4" />
        <span>Jenjang Kemitraan Fleksibel</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Mulai sebagai Reseller, Tumbuh Menjadi Agen</h2>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        Semua pengguna mulai secara gratis. Kumpulkan transaksi Anda dan ajukan upgrade ke status Mitra Agen kapan saja langsung dari aplikasi!
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {tiers.map((tier) => (
        <div class={`relative p-8 lg:p-12 rounded-3xl transition-all duration-300 flex flex-col justify-between ${tier.highlight ? 'bg-primary text-white shadow-2xl shadow-primary/30 md:scale-105 z-10' : 'bg-white text-slate-900 border border-slate-100 shadow-sm'}`}>
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="flex items-center space-x-4">
                <div class={`p-3 rounded-2xl ${tier.highlight ? 'bg-white/20 text-white' : 'bg-primary/10 text-primary'}`}>
                  <tier.icon class="w-8 h-8" />
                </div>
                <div>
                  <h3 class="text-2xl font-bold">{tier.name}</h3>
                  <span class={`text-xs font-semibold px-2.5 py-0.5 rounded-full ${tier.highlight ? 'bg-white/20 text-white' : 'bg-slate-100 text-slate-600'}`}>
                    {tier.badge}
                  </span>
                </div>
              </div>
            </div>
            
            <p class={`mb-8 text-sm leading-relaxed ${tier.highlight ? 'text-white/90' : 'text-slate-600'}`}>
              {tier.description}
            </p>

            <ul class="space-y-4 mb-10">
              {tier.features.map((feature) => (
                <li class="flex items-start space-x-3 text-sm">
                  <CheckCircle2 class={`w-5 h-5 flex-shrink-0 mt-0.5 ${tier.highlight ? 'text-secondary-light' : 'text-primary'}`} />
                  <span class="font-medium" set:html={feature}></span>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <a 
              href={tier.link} 
              class={`flex items-center justify-center space-x-2 w-full text-center py-4 rounded-xl font-bold transition-all ${tier.highlight ? 'bg-white text-primary hover:bg-slate-100 shadow-lg' : 'bg-primary text-white hover:bg-primary-dark shadow-lg shadow-primary/20'}`}
            >
              <span>{tier.cta}</span>
              <ArrowRight class="w-5 h-5" />
            </a>
            <p class={`text-center text-xs mt-3 ${tier.highlight ? 'text-white/75' : 'text-slate-400'}`}>
              {tier.footnote}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
