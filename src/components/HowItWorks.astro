---
const steps = [
  {
    stepId: 1,
    number: '01',
    title: 'Download & Daftar',
    description: 'Unduh APK Gampang Beres dan daftar gratis dalam 1 menit menggunakan nomor HP WhatsApp Anda.',
    badge: 'Langkah 1: Registrasi Akun',
  },
  {
    stepId: 2,
    number: '02',
    title: 'Isi Saldo (Smart Deposit)',
    description: 'Deposit instan via QRIS Otomatis 24 Jam atau Transfer GoPay Manual bebas biaya potongan MDR.',
    badge: 'Langkah 2: Isi Saldo Instan',
  },
  {
    stepId: 3,
    number: '03',
    title: 'Transaksi & Cetak Struk',
    description: 'Pilih layanan, nikmati Jalur Hemat otomatis, dan cetak struk kasir Bluetooth dengan nama toko Anda.',
    badge: 'Langkah 3: Sukses & Cetak Struk',
  },
];
---

<section class="py-12 sm:py-16 lg:py-24 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-8 sm:gap-12 lg:gap-16">
      
      <!-- Sisi Kiri: 3 Langkah Navigasi Interaktif -->
      <div class="lg:w-1/2">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold mb-3 sm:mb-4">
          <span>Panduan Interaktif</span>
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 mb-3 sm:mb-6">
          Hanya 3 Langkah Mudah untuk Memulai
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mb-6 sm:mb-10 leading-relaxed">
          Dirancang praktis dan bersih agar siapa saja, mulai dari pemula hingga pemilik konter pulsa berpengalaman, bisa langsung jualan dalam hitungan menit.
        </p>
        
        <div class="space-y-3 sm:space-y-4" id="step-selector-container">
          {steps.map((step) => (
            <div 
              role="button"
              tabindex="0"
              aria-label={`Langkah ${step.number}: ${step.title}`}
              class={`step-card cursor-pointer p-4 sm:p-5 rounded-2xl border transition-all duration-300 flex items-start space-x-3.5 sm:space-x-5 ${step.stepId === 1 ? 'active-step bg-slate-50 border-primary shadow-sm' : 'border-slate-100 hover:border-slate-200 bg-white'}`}
              data-step={step.stepId}
            >
              <div class="step-num text-2xl sm:text-3xl font-black transition-colors duration-300 pt-0.5 flex-shrink-0">
                {step.number}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-1">
                  <h3 class="step-title text-base sm:text-lg font-bold transition-colors duration-300">
                    {step.title}
                  </h3>
                  <span class="step-badge text-[10px] sm:text-[11px] font-bold px-2 py-0.5 rounded-full transition-all duration-300 w-max">
                    {step.badge}
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{step.description}</p>
              </div>
            </div>
          ))}
        </div>

        <p class="text-xs text-slate-400 mt-4 italic">
          💡 Klik atau sentuh salah satu langkah di atas untuk melihat simulasi tampilan aplikasi aslinya di samping.
        </p>
      </div>

      <!-- Sisi Kanan: Mockup Smartphone 1:1 Tampilan Aplikasi Mobile Asli -->
      <div class="lg:w-1/2 relative w-full max-w-sm mx-auto">
        <!-- Bingkai Smartphone Android -->
        <div class="w-full bg-slate-900 rounded-[3rem] p-3 shadow-2xl shadow-slate-900/40 border-[4px] border-slate-800 relative">
          
          <!-- Speaker Notch & Camera Pin -->
          <div class="absolute top-5 left-1/2 -translate-x-1/2 flex items-center space-x-2 z-30">
            <div class="w-12 h-1.5 bg-slate-800 rounded-full"></div>
            <div class="w-2.5 h-2.5 bg-slate-800 rounded-full"></div>
          </div>

          <!-- Layar HP (Screen Canvas) -->
          <div class="w-full bg-[#F5F5F5] rounded-[2.5rem] overflow-hidden pt-8 pb-4 px-4 min-h-[480px] flex flex-col justify-between text-slate-900 relative">
            
            <!-- Android Status Bar 1:1 -->
            <div class="flex justify-between items-center text-[11px] font-semibold text-slate-600 px-2 mb-3">
              <span>08:28</span>
              <div class="flex items-center space-x-1 text-[10px]">
                <span>📶 4G</span>
                <span>🔋 98%</span>
              </div>
            </div>

            <!-- TAB SCREEN 1:1 -->
            <div class="flex-1 relative">
              
              <!-- SCREEN 1: REGISTER / MASUK (1:1 RegisterPage.dart) -->
              <div id="screen-1" class="screen-view transition-all duration-500 opacity-100 transform translate-y-0">
                <!-- App Bar Header -->
                <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-100 mb-3">
                  <div class="flex items-center space-x-2 mb-2">
                    <div class="w-7 h-7 rounded-lg bg-primary flex items-center justify-center text-white font-black text-xs">
                      GB
                    </div>
                    <span class="text-sm font-bold text-slate-900">Gampang Beres</span>
                  </div>
                  <h4 class="text-base font-extrabold text-primary">Daftar Akun Baru</h4>
                  <p class="text-[11px] text-slate-500">Mulai transaksi hemat dan cuan maksimal</p>
                </div>

                <!-- Input Form Mockup 1:1 -->
                <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-100 space-y-2.5">
                  <div>
                    <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Nama Lengkap / Nama Toko</label>
                    <div class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold text-slate-800">
                      Konter Berkah Seluler
                    </div>
                  </div>
                  <div>
                    <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Nomor WhatsApp Aktif</label>
                    <div class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold text-slate-800 flex items-center justify-between">
                      <span>0812-9876-5432</span>
                      <span class="text-[10px] text-green-600 font-bold">✓ OTP Terkirim</span>
                    </div>
                  </div>
                  <div class="pt-1">
                    <div class="w-full bg-primary text-white py-2.5 rounded-xl font-bold text-xs text-center shadow-md shadow-primary/25">
                      Daftar Gratis Sekarang
                    </div>
                  </div>
                </div>

                <!-- Reseller Tag -->
                <div class="mt-3 p-2.5 rounded-xl bg-blue-50 border border-blue-100 text-center">
                  <p class="text-[10px] text-blue-800 font-semibold">
                    ✨ Pendaftaran 100% Gratis & langsung aktif harga reseller
                  </p>
                </div>
              </div>

              <!-- SCREEN 2: DEPOSIT QRIS & GOPAY (1:1 DepositPaymentPage.dart) -->
              <div id="screen-2" class="screen-view transition-all duration-500 opacity-0 transform translate-y-4 absolute inset-0 pointer-events-none">
                <!-- App Bar Header -->
                <div class="flex items-center justify-between bg-white rounded-2xl p-3 shadow-sm border border-slate-100 mb-3">
                  <div class="flex items-center space-x-2">
                    <span class="text-slate-400 text-xs">←</span>
                    <span class="text-xs font-bold text-slate-800">Pembayaran Deposit</span>
                  </div>
                  <span class="text-[10px] font-extrabold text-primary bg-primary/10 px-2 py-0.5 rounded-full">QRIS Otomatis</span>
                </div>

                <!-- QRIS Card 1:1 -->
                <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-100 text-center">
                  <span class="text-[10px] text-slate-400 uppercase font-bold tracking-wider">Scan QRIS Semua Pembayaran</span>
                  
                  <!-- QR Code Mockup Graphic -->
                  <div class="w-28 h-28 mx-auto my-2.5 bg-slate-900 rounded-xl p-2 flex flex-col justify-between shadow-inner relative overflow-hidden">
                    <div class="flex justify-between">
                      <div class="w-6 h-6 border-2 border-white rounded-md flex items-center justify-center">
                        <div class="w-2.5 h-2.5 bg-white rounded-sm"></div>
                      </div>
                      <div class="w-6 h-6 border-2 border-white rounded-md flex items-center justify-center">
                        <div class="w-2.5 h-2.5 bg-white rounded-sm"></div>
                      </div>
                    </div>
                    <div class="flex items-center justify-center">
                      <div class="w-6 h-6 rounded-md bg-primary flex items-center justify-center text-white text-[8px] font-black">
                        GB
                      </div>
                    </div>
                    <div class="flex justify-between">
                      <div class="w-6 h-6 border-2 border-white rounded-md flex items-center justify-center">
                        <div class="w-2.5 h-2.5 bg-white rounded-sm"></div>
                      </div>
                      <div class="w-4 h-4 bg-white/40 rounded-sm"></div>
                    </div>
                  </div>

                  <p class="text-[11px] text-slate-500 font-medium">Bisa dari DANA, OVO, GoPay, ShopeePay & m-Banking</p>
                  
                  <div class="mt-2.5 pt-2.5 border-t border-dashed border-slate-100 flex justify-between items-center text-xs">
                    <span class="text-slate-400">Nominal Transfer</span>
                    <span class="text-sm font-black text-slate-900">Rp 100.000</span>
                  </div>
                </div>

                <!-- Success Toast Simulation -->
                <div class="mt-2.5 p-2 rounded-xl bg-emerald-100 border border-emerald-200 text-center flex items-center justify-center space-x-1.5">
                  <span class="text-emerald-700 font-bold text-[10px]">✓ Saldo otomatis masuk dalam hitungan detik 24/7</span>
                </div>
              </div>

              <!-- SCREEN 3: STRUK KASIR & RESI SUKSES (1:1 ReceiptPage.dart) -->
              <div id="screen-3" class="screen-view transition-all duration-500 opacity-0 transform translate-y-4 absolute inset-0 pointer-events-none">
                <!-- App Bar Header -->
                <div class="flex items-center justify-between bg-white rounded-2xl p-3 shadow-sm border border-slate-100 mb-2">
                  <div class="flex items-center space-x-1.5">
                    <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                    <span class="text-xs font-bold text-slate-800">Struk Pembayaran Resmi</span>
                  </div>
                  <span class="text-[10px] font-bold text-green-700 bg-green-100 px-2 py-0.5 rounded-full">LUNAS</span>
                </div>

                <!-- Struk Detail 1:1 -->
                <div class="bg-white rounded-2xl p-3.5 shadow-sm border border-slate-100 space-y-2 text-xs">
                  <div class="flex justify-between items-center">
                    <span class="text-slate-400 text-[11px]">Nama Toko</span>
                    <span class="font-bold text-slate-800">Berkah Seluler</span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-slate-400 text-[11px]">Layanan</span>
                    <span class="font-bold text-slate-800">Token Listrik PLN 50K</span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-slate-400 text-[11px]">ID Pelanggan</span>
                    <span class="font-mono font-semibold text-slate-700">3201-9872-4410</span>
                  </div>
                  <div class="bg-slate-50 p-2 rounded-xl text-center border border-slate-100">
                    <span class="block text-[10px] text-slate-400 uppercase font-bold">Kode Token Stroom</span>
                    <span class="font-mono text-sm font-black text-slate-900 tracking-wider">4920-1184-7729-0193</span>
                  </div>
                  <div class="border-t border-dashed border-slate-200 pt-2 flex justify-between items-center">
                    <span class="font-bold text-slate-800">Total Tagihan</span>
                    <span class="font-black text-primary text-sm">Rp 52.000</span>
                  </div>
                </div>

                <!-- Tombol Aksi 1:1 (Cetak Struk Bluetooth & Kirim WA) -->
                <div class="grid grid-cols-2 gap-2 mt-2.5">
                  <div class="bg-primary text-white py-2 rounded-xl font-bold text-[11px] text-center shadow-md shadow-primary/20 flex items-center justify-center space-x-1">
                    <span>🖨️ Cetak Thermal</span>
                  </div>
                  <div class="bg-[#25D366] text-white py-2 rounded-xl font-bold text-[11px] text-center shadow-md shadow-[#25D366]/20 flex items-center justify-center space-x-1">
                    <span>💬 Kirim WA</span>
                  </div>
                </div>

                <!-- Jalur Hemat Banner -->
                <div class="mt-2 p-1.5 rounded-lg bg-emerald-50 border border-emerald-100 text-center">
                  <p class="text-[9px] text-emerald-800 font-semibold">
                    💡 Jalur Hemat: Auto-refund selisih harga Rp 350
                  </p>
                </div>
              </div>

            </div>

            <!-- Android Bottom Navigation Indicator -->
            <div class="w-24 h-1 bg-slate-300 rounded-full mx-auto mt-2"></div>

          </div>
        </div>

        <!-- Decorative Blur Background -->
        <div class="absolute -z-10 -bottom-10 -right-10 w-64 h-64 bg-primary/15 rounded-full blur-3xl"></div>
        <div class="absolute -z-10 -top-10 -left-10 w-64 h-64 bg-secondary/15 rounded-full blur-3xl"></div>
      </div>

    </div>
  </div>
</section>

<style>
  .step-card.active-step {
    border-color: #3b82f6;
    background-color: #eff6ff;
  }
  .step-card.active-step .step-num {
    color: #2563eb;
  }
  .step-card.active-step .step-title {
    color: #1d4ed8;
  }
  .step-card.active-step .step-badge {
    background-color: #2563eb;
    color: #ffffff;
  }

  .step-card:not(.active-step) .step-num {
    color: #94a3b8;
  }
  .step-card:not(.active-step) .step-title {
    color: #0f172a;
  }
  .step-card:not(.active-step) .step-badge {
    background-color: #f1f5f9;
    color: #64748b;
  }
</style>

<script>
  let currentStep = 1;
  const totalSteps = 3;
  let autoTimer: any = null;

  const setStep = (stepNumber: number) => {
    currentStep = stepNumber;

    // 1. Update Card active state
    document.querySelectorAll('.step-card').forEach((el) => {
      const step = Number(el.getAttribute('data-step'));
      if (step === stepNumber) {
        el.classList.add('active-step');
        el.classList.remove('bg-white', 'border-slate-100');
      } else {
        el.classList.remove('active-step');
        el.classList.add('bg-white', 'border-slate-100');
      }
    });

    // 2. Switch Smartphone Screen
    for (let i = 1; i <= totalSteps; i++) {
      const screenEl = document.getElementById(`screen-${i}`);
      if (screenEl) {
        if (i === stepNumber) {
          screenEl.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4', 'absolute');
          screenEl.classList.add('opacity-100', 'translate-y-0');
        } else {
          screenEl.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4', 'absolute');
          screenEl.classList.remove('opacity-100', 'translate-y-0');
        }
      }
    }
  };

  // Click and keyboard handler
  document.querySelectorAll('.step-card').forEach((card) => {
    const handleActivate = () => {
      const step = Number(card.getAttribute('data-step'));
      setStep(step);
      resetAutoTimer();
    };

    card.addEventListener('click', handleActivate);
    card.addEventListener('keydown', (e) => {
      const keyboardEvent = e as KeyboardEvent;
      if (keyboardEvent.key === 'Enter' || keyboardEvent.key === ' ') {
        keyboardEvent.preventDefault();
        handleActivate();
      }
    });
  });

  // Auto rotate every 5 seconds
  const startAutoTimer = () => {
    autoTimer = setInterval(() => {
      currentStep = currentStep >= totalSteps ? 1 : currentStep + 1;
      setStep(currentStep);
    }, 5000);
  };

  const resetAutoTimer = () => {
    if (autoTimer) clearInterval(autoTimer);
    startAutoTimer();
  };

  startAutoTimer();
</script>
