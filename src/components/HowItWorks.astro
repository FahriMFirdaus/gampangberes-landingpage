---
const steps = [
  {
    number: '01',
    title: 'Download & Daftar',
    description: 'Unduh APK Gampang Beres dan daftar menggunakan nomor HP aktif Anda.',
  },
  {
    number: '02',
    title: 'Isi Saldo (Deposit)',
    description: 'Tambahkan saldo dengan mudah melalui QRIS yang mendukung semua aplikasi pembayaran dan m-banking (Otomatis).',
  },
  {
    number: '03',
    title: 'Mulai Transaksi',
    description: 'Pilih layanan, masukkan nomor tujuan, dan saldo akan otomatis terpotong saat sukses.',
  },
];
---

<section class="py-24 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-16">
      <div class="lg:w-1/2">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-6">Hanya 3 Langkah Mudah untuk Memulai</h2>
        <p class="text-lg text-slate-600 mb-10">
          Kami merancang aplikasi Gampang Beres agar mudah digunakan oleh siapa saja, bahkan bagi pemula sekalipun.
        </p>
        
        <div class="space-y-10">
          {steps.map((step) => (
            <div class="flex items-start space-x-6">
              <div class="text-4xl font-black text-primary/60 flex-shrink-0 pt-1">
                {step.number}
              </div>
              <div>
                <h3 class="text-xl font-bold text-slate-900 mb-2">{step.title}</h3>
                <p class="text-slate-600 leading-relaxed">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Mockup Illustration Interactive Card -->
      <div class="lg:w-1/2 relative w-full max-w-md mx-auto">
        <div class="w-full bg-white rounded-[2.5rem] border-[8px] border-slate-900 shadow-2xl overflow-hidden relative p-6">
          <!-- Smartphone Header -->
          <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-4">
            <div class="flex items-center space-x-2">
              <div class="w-8 h-8 rounded-xl bg-primary flex items-center justify-center text-white font-black text-sm">
                GB
              </div>
              <div>
                <p class="text-xs font-bold text-slate-800">Konter Gampang Beres</p>
                <p class="text-[10px] text-green-600 font-semibold flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Online
                </p>
              </div>
            </div>
            <span class="text-xs font-extrabold text-primary bg-primary/10 px-2.5 py-1 rounded-full">Mitra Agen</span>
          </div>

          <!-- Struk / Transaksi Card Mockup -->
          <div class="bg-slate-50 rounded-2xl p-4 border border-slate-100 mb-4 space-y-3">
            <div class="flex justify-between items-center text-xs">
              <span class="text-slate-400">Status</span>
              <span class="px-2 py-0.5 rounded-full bg-green-100 text-green-700 font-bold text-[11px]">BERHASIL</span>
            </div>
            <div class="flex justify-between items-center text-xs">
              <span class="text-slate-400">Layanan</span>
              <span class="font-bold text-slate-800">Token PLN 50.000</span>
            </div>
            <div class="flex justify-between items-center text-xs">
              <span class="text-slate-400">Nomor Meter</span>
              <span class="font-mono text-slate-700 font-semibold">3201-9872-4410</span>
            </div>
            <div class="border-t border-dashed border-slate-200 pt-2 flex justify-between items-center text-xs">
              <span class="font-bold text-slate-800">Total Bayar</span>
              <span class="font-extrabold text-primary text-sm">Rp 50.500</span>
            </div>
          </div>

          <!-- Quick Action Buttons -->
          <div class="grid grid-cols-2 gap-2 text-center text-xs font-bold">
            <div class="p-2.5 rounded-xl bg-primary text-white flex items-center justify-center gap-1.5 shadow-sm shadow-primary/30">
              <span>Cetak Struk</span>
            </div>
            <div class="p-2.5 rounded-xl bg-secondary text-white flex items-center justify-center gap-1.5 shadow-sm shadow-secondary/30">
              <span>Kirim WA</span>
            </div>
          </div>

          <!-- Decorative bottom banner -->
          <div class="mt-4 p-2.5 rounded-xl bg-emerald-50 border border-emerald-100 text-center">
            <p class="text-[11px] text-emerald-800 font-medium">
              💡 Jalur Hemat aktif: Hemat Rp 350 pada transaksi ini!
            </p>
          </div>
        </div>
        <!-- Accent Glow -->
        <div class="absolute -z-10 -bottom-8 -right-8 w-60 h-60 bg-primary/15 rounded-full blur-3xl"></div>
      </div>
    </div>
  </div>
</section>
